+// A texture with see-through parts (foliage, fences, wire) keeps its one level: averaged down, its alpha thinned
+// whatever the game's test or blend made of it, and the plants faded away within a few steps. Drawn from the top
+// level alone, as the console drew it; opaque textures keep their chain
+bool SeeThrough(const std::vector<uint8_t>& px) {
+    for (size_t i = 3; i < px.size(); i += 4)
+        if (px[i] != 255) return true;
+    return false;
+}
