+// Compiled shaders kept on disk (shadercache beside the executable, a file each by its hash), so each compiles once
+// ever: a draw's first shader compiled as the game runs stalls it, 100 ms and more for some. Another compiler or
+// other flags make other files (kShaderCacheVersion)
+constexpr uint64_t kShaderCacheVersion = 1;
+
+std::filesystem::path ShaderCachePath(uint64_t hash) {
+    char name[32];
+    std::snprintf(name, sizeof(name), "%016llx.dxbc", (unsigned long long)(hash ^ kShaderCacheVersion));
+    return app::ExeDir() / "shadercache" / name;
+}
+
+// the shader's cached code, a new blob, or none
+ID3DBlob* CachedShader(uint64_t hash) {
+    FILE* f = _wfopen(ShaderCachePath(hash).c_str(), L"rb");
+    if (!f) return nullptr;
+    std::fseek(f, 0, SEEK_END);
+    long size = std::ftell(f);
+    std::fseek(f, 0, SEEK_SET);
+    ID3DBlob* blob = nullptr;
+    if (size <= 0 || FAILED(D3DCreateBlob(size_t(size), &blob))) blob = nullptr;
+    else if (std::fread(blob->GetBufferPointer(), 1, size_t(size), f) != size_t(size)) blob->Release(), blob = nullptr;
+    std::fclose(f);
+    return blob;
+}
+
+void CacheShader(uint64_t hash, ID3DBlob* code) {
+    std::error_code ec;
+    std::filesystem::path path = ShaderCachePath(hash), part = path;
+    part += L".part";
+    std::filesystem::create_directories(path.parent_path(), ec);
+    FILE* f = _wfopen(part.c_str(), L"wb");
+    if (!f) return;
+    bool ok = std::fwrite(code->GetBufferPointer(), 1, code->GetBufferSize(), f) == code->GetBufferSize();
+    ok = std::fclose(f) == 0 && ok;
+    if (ok) std::filesystem::rename(part, path, ec);
+    else std::filesystem::remove(part, ec);
+}
+
