+// the hitch log: a frame over 50 ms and three times the frames before it, with what the frame did (a level's streaming,
+// a first draw's shaders and pipelines, new textures, waits)
+void LogHitch() {
+    static PerfClock::time_point last = PerfClock::now();
+    static double average = 16.7;
+    static Perf before;
+    static uint64_t reads_before = 0, read_bytes_before = 0, read_ns_before = 0, wait_before = 0, capture_before = 0;
+    double ms = PerfMs(last);
+    last = PerfClock::now();
+    uint64_t reads = kernel::g_reads.load(), read_bytes = kernel::g_read_bytes.load(), read_ns = kernel::g_read_ns.load();
+    uint64_t wait = g_perf_wait_ns.load(), capture = g_perf_capture_ns.load();
+    const Perf& p = g_perf;
+    if (ms > 50.0 && ms > average * 3.0)
+        LOGI("hitch: %.0f ms frame (%.1f ms before) | %llu shaders %.1f ms, %llu psos | %llu new tex, %llu tex uploads "
+             "%.2f MB %.1f ms | draw %.1f ms, sync %.1f ms, %llu read-backs | title: recording %.1f ms, waiting "
+             "%.1f ms | %llu reads %.2f MB %.1f ms",
+             ms, average, (unsigned long long)(p.shaders - before.shaders), p.compile - before.compile,
+             (unsigned long long)(p.psos - before.psos), (unsigned long long)(p.newtex - before.newtex),
+             (unsigned long long)(p.texups - before.texups), (p.texup_bytes - before.texup_bytes) / 1048576.0,
+             p.texup - before.texup, p.draw - before.draw, p.sync - before.sync,
+             (unsigned long long)(p.syncs - before.syncs), (capture - capture_before) / 1e6,
+             (wait - wait_before) / 1e6, (unsigned long long)(reads - reads_before),
+             (read_bytes - read_bytes_before) / 1048576.0, (read_ns - read_ns_before) / 1e6);
+    average = average * 0.9 + std::min(ms, 100.0) * 0.1;
+    before = p;
+    reads_before = reads, read_bytes_before = read_bytes, read_ns_before = read_ns;
+    wait_before = wait, capture_before = capture;
+}
+
 void LogPerf() {
     static PerfClock::time_point perf_start = PerfClock::now();
     static uint64_t perf_frames = 0;
@@ -3449,6 +3483,7 @@
     ReleaseOldTextures();
