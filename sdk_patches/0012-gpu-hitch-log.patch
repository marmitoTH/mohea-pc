     return on;
+}
+
+// a frame much longer than the ones before it logged with what it did: with XBE_PERF, or always in a build with asserts
+// (the dev build)
+inline bool Hitches() {
+#ifdef NDEBUG
+    return Perf();
+#else
+    return true;
+#endif
 }
 
