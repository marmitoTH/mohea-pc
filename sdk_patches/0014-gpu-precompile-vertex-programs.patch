+uint16_t DeclaredRegs(const VertexShader& vs, uint64_t& decode) {
+    uint16_t regs = 0;
+    decode = 0;
+    for (int r = 0; r < 16; r++) {
+        const auto& in = vs.inputs[size_t(r)];
+        if (in.stream < 0 || !in.type || in.type == kTypeNone) continue;
+        regs |= uint16_t(1u << r);
+        decode |= uint64_t(HostFormat(in.type).decode) << (r * 4);
+    }
+    return regs;
+}
