+void PrecompileVertexShader(const VertexShader& vs) {
+    static Precompiler precompiler;
+    if (vs.program.empty() || vs.program_type != 0x2078) return;
+    uint64_t decode = 0;
+    uint16_t regs = DeclaredRegs(vs, decode);
+    if (!regs) return;
+    precompiler.Add(ReversedDepthHlsl(VertexProgramHlsl(vs.program, regs, decode)));
+    // the same inputs converted on the CPU, which reach the shader as plain floats
+    if (decode) precompiler.Add(ReversedDepthHlsl(VertexProgramHlsl(vs.program, regs, 0)));
+}
+
 }  // namespace gpu
