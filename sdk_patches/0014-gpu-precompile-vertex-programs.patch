+constexpr UINT kCompileFlags = D3DCOMPILE_OPTIMIZATION_LEVEL1;
+
+// Vertex programs compiled as the title makes them (PrecompileVertexShader), while a level loads, on threads of their
+// own into the shader cache, for the declaration's inputs as a draw most likely reads them: the draw then finds its
+// shader there instead of compiling it. One with other inputs, a screen quad's or the fixed function pipeline's is
+// still compiled by its draw
+class Precompiler {
+public:
+    void Add(std::string src) {
+        std::lock_guard lock(m_);
+        if (threads_.empty()) {
+            unsigned n = std::max(1u, std::min(4u, std::thread::hardware_concurrency() / 2));
+            for (unsigned i = 0; i < n; i++) threads_.emplace_back([this] { Run(); });
+        }
+        queue_.push_back(std::move(src));
+        cv_.notify_one();
+    }
+
+private:
+    void Run() {
+        SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+        for (;;) {
+            std::string src;
+            {
+                std::unique_lock lock(m_);
+                cv_.wait(lock, [&] { return !queue_.empty(); });
+                src = std::move(queue_.front());
+                queue_.pop_front();
+            }
+            uint64_t hash = ShaderHash(src, "main", "vs_5_0");
+            std::error_code ec;
+            if (std::filesystem::exists(ShaderCachePath(hash), ec)) continue;
+            ComPtr<ID3DBlob> code;
+            if (SUCCEEDED(D3DCompile(src.data(), src.size(), nullptr, nullptr, nullptr, "main", "vs_5_0",
+                                     kCompileFlags, 0, &code, nullptr))) {
+                CacheShader(hash, code.Get());
+                g_precompiled++;
+            }
+        }
+    }
+
+    std::mutex m_;
+    std::condition_variable cv_;
+    std::deque<std::string> queue_;
+    std::vector<std::thread> threads_;  // run to the end: detached at exit with the process
+};
