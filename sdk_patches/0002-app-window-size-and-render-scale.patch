             }
             break;
+        case WM_ENTERSIZEMOVE:
+            g_sizing = true;
+            break;
+        case WM_EXITSIZEMOVE:
+            g_sizing = false;
+            TrackWindowSize(hwnd);
+            break;
+        case WM_SIZE:
+            if (!g_sizing && wp != SIZE_MINIMIZED) TrackWindowSize(hwnd);
