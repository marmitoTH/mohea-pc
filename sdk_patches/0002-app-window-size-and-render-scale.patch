+// the window's size for the render scale, windowed: its client height unless maximized, where the full screen
+// resolution applies; once a resize ends (not on each step of a drag), and kept for the next start
+bool g_sizing = false;
+void TrackWindowSize(HWND hwnd) {
+    Settings& s = Get();
+    RECT rc{};
+    GetClientRect(hwnd, &rc);
+    if (s.display_mode != DisplayMode::Windowed || IsZoomed(hwnd)) {
+        SetWindowHeight(0);
+    } else if (!IsIconic(hwnd) && rc.right > 0 && rc.bottom > 0) {
+        SetWindowHeight(uint32_t(rc.bottom));
+        if (s.window_width != uint32_t(rc.right) || s.window_height != uint32_t(rc.bottom)) {
+            s.window_width = uint32_t(rc.right);
+            s.window_height = uint32_t(rc.bottom);
+            Save();
+        }
+    }
+}
+
