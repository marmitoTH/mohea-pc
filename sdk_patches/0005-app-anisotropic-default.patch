Anisotropic filtering at 16x by default (it was as the game asks); the setting takes 2, 4, 8 or 16, anything else
being as the game asks.

diff --git a/runtime/app/app.h b/runtime/app/app.h
index e3727b3..58672d5 100644
--- a/runtime/app/app.h
+++ b/runtime/app/app.h
@@ -28,7 +28,7 @@ struct Settings {
     float saturation = 1.5f;         // the colour, 0 (grey) to 2
     uint32_t fps_cap = 60;           // 0 unlimited, kFpsCapRefresh the monitor's refresh rate
     bool vsync = true;
-    uint32_t aniso = 0;              // 0 as the game asks
+    uint32_t aniso = 16;             // anisotropic filtering, 2, 4, 8 or 16; 0 as the game asks
     bool custom_textures = true;     // images in textures\replacement\ beside the exe replace the game's
     bool dump_textures = false;      // each texture once into textures\dumps\ beside the exe
     uint32_t texture_dump_format = 0;  // 0 PNG, 1 DDS
diff --git a/runtime/app/settings.cpp b/runtime/app/settings.cpp
index 756f5ba..a7e6e19 100644
--- a/runtime/app/settings.cpp
+++ b/runtime/app/settings.cpp
@@ -60,6 +60,7 @@ void Load() {
     s.fps_cap = t["fps_cap"].value_or(s.fps_cap);
     s.vsync = t["vsync"].value_or(s.vsync);
     s.aniso = t["anisotropic_filtering"].value_or(s.aniso);
+    if (s.aniso != 2 && s.aniso != 4 && s.aniso != 8 && s.aniso != 16) s.aniso = 0;
     s.custom_textures = t["custom_textures"].value_or(s.custom_textures);
     s.dump_textures = t["dump_textures"].value_or(s.dump_textures);
     s.texture_dump_format = std::min(t["texture_dump_format"].value_or(s.texture_dump_format), 1u);
