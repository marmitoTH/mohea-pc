The render scale in place of the supersampling: render_percent (of the output height, 50 to 200, 100 by default) is
the one size the game's 3D picture is drawn at, below 100 cheaper and softer, over it sharper and antialiased as the
present averages it back (Blit's taps, spread over each shown pixel, so 150 averages as well as 200). The
antialiasing setting (supersampling's samples, which raised the scale by their square root) is gone with it; an old
settings file's is ignored.

diff --git a/runtime/app/app.h b/runtime/app/app.h
index ebf4f6d..9a49920 100644
--- a/runtime/app/app.h
+++ b/runtime/app/app.h
@@ -20,8 +20,7 @@ struct Settings {
     DisplayMode display_mode = DisplayMode::Borderless;
     uint32_t width = 0, height = 0;  // 0 is the desktop mode
     uint32_t window_width = 1280, window_height = 720;  // the window's client size, windowed and not maximized
-    uint32_t render_percent = 100;   // of the output height
-    uint32_t antialiasing = 0;       // supersampling: samples a pixel, 2, 4, 8 or 16; 0 off
+    uint32_t render_percent = 100;   // of the output height, 50 to 200
     // the shown frame's grade, each 1 as the game draws it
     float gamma = 1.2f;              // the midtones, 0.5 to 2, black and white staying
     float contrast = 1.1f;           // an S-curve about mid grey, 0.5 to 2, black and white staying
diff --git a/runtime/app/settings.cpp b/runtime/app/settings.cpp
