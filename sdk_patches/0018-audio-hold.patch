+    if (audio::g_hold.load()) {
+        std::fill(out, out + size_t(frames) * 2, 0.0f);
+        return;
+    }
     static std::vector<float> bins;  // the output thread alone renders
     bins.assign(size_t(frames) * kBins, 0.0f);
     std::lock_guard<std::recursive_mutex> lock(g_lock);
